# ── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API.
# The service-role key bypasses RLS. It is used only by server code in this app
# and must never appear in a NEXT_PUBLIC_ variable.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_MEDIA_BUCKET=post-media

# ── Web UI ───────────────────────────────────────────────────────────────────
# The password for the single login screen.
APP_PASSWORD=pick-something-long
# Signs the session cookie. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Machine access ───────────────────────────────────────────────────────────
# Claude Code sends this as `Authorization: Bearer ...` on /api/*.
CADENCE_API_KEY=
# The scheduler sends this on /api/cron/publish. Keep it different from the above
# so a leaked publishing token cannot also read and edit every draft.
CRON_SECRET=

# ── LinkedIn ─────────────────────────────────────────────────────────────────
# Same two values as the repo root .env — the webapp publishes directly rather
# than shelling out to scripts/publish_post.py.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:xxxxxxxx

# ── Behaviour ────────────────────────────────────────────────────────────────
# Wall-clock timezone for every slot and calendar cell.
APP_TIMEZONE=Asia/Kolkata
# true → the scheduler logs what it would send and posts nothing. Leave this on
# until you have watched one slot come and go safely.
PUBLISH_DRY_RUN=true
